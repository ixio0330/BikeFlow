{
  "name": "bikeflow",
  "private": true,
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "dev": "pnpm --parallel --filter @bikeflow/web --filter @bikeflow/api dev",
    "dev:web": "pnpm --filter @bikeflow/web dev",
    "dev:api": "pnpm --filter @bikeflow/api dev",
    "build": "pnpm --recursive --if-present build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "oxlint apps packages",
    "test": "pnpm --recursive --if-present test",
    "typecheck": "pnpm --recursive --if-present typecheck",
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "9.1.7",
    "lint-staged": "17.5.0",
    "oxlint": "1.82.0",
    "prettier": "3.9.6",
    "prettier-plugin-tailwindcss": "0.8.1"
  },
  "lint-staged": {
    "*": "prettier --write --ignore-unknown"
  }
}
