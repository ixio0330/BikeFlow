{
  "name": "bikeflow",
  "private": true,
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "dev": "pnpm --parallel --filter @bikeflow/web --filter @bikeflow/api dev",
    "dev:web": "pnpm --filter @bikeflow/web dev",
    "dev:api": "pnpm --filter @bikeflow/api dev",
    "build": "pnpm --recursive --if-present build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "oxlint apps packages",
    "test": "pnpm --recursive --if-present test",
    "typecheck": "pnpm --recursive --if-present typecheck"
  },
  "devDependencies": {
    "oxlint": "1.82.0",
    "prettier": "3.4.2"
  }
}
